  "aeroscapes_reimagine.config.literal.0237a6629dc21d9b6ba33725ae266b449c000c2bd954201f262d33cce60e4e1d": " If enabled, dimensions without ceilings (like the Overworld) will only display dimension titles when the player is exposed to the skylight.",
  "aeroscapes_reimagine.config.literal.026540906a3ef6ac3823aa6f0a3553c9eb9b5e0c9daafa84eae7f9e3805cebb1": " The text's horizontal position on the screen.",
  "aeroscapes_reimagine.config.literal.03451ec1dd231cd289d2614bddc112c247b04043e712f7a6031cf1eb94e29f8e": " If Horizontally Center Title is disabled, this number is relative to the top of the screen.",
  "aeroscapes_reimagine.config.literal.07bff95c14ffe868daa40fd0450e10c1e9ae4365c5599fd22a4aa8e8e8bcff9a": " the Waystone title will take precedence.",
  "aeroscapes_reimagine.config.literal.0db6db249e04d3292a190adb60dcd1275ca72ef2195687791e99d6bde2cb1ce4": " Biomes that should not have any title displayed when the player enters them.",
  "aeroscapes_reimagine.config.literal.158e60caeec476c92aff1b302d060ecd7f2e6e815780dab56868a3f209d56fa1": " That is, if a player enters the area for a Waystone while also entering a new biome,",
  "aeroscapes_reimagine.config.literal.2038a637e157ae802bef417ce10c2a2b7db3ff253613969b789b59e910dbc159": " How long the fade-out text effect lasts, in ticks.",
  "aeroscapes_reimagine.config.literal.217d52e57dd06819ea444d03bd564763d47666ecaf182d5344d4370420491f5d": " The volume of the sound that plays when a biome title displays.",
  "aeroscapes_reimagine.config.literal.23bde1b05f391f20999a5cfef14489fd8b974a5938afd7237107908f76e8f826": " Whether or not the biome text should be centered on the screen.",
  "aeroscapes_reimagine.config.literal.26b4acea4b9ac368c7c2b50fb13e61df19617a6e74a351468497b41d13cc7cf6": " Whether or not Waystone titles should override Biome titles.",
  "aeroscapes_reimagine.config.literal.2d059339a54d9bc7851d0c05be6650d0eb06d4d7679cfa10ecfb8b9a32cce668": "# Biome Title settings.",
  "aeroscapes_reimagine.config.literal.2f1483f82546e39a5d1e92b6b943a9d9d5a06c3047aaae329cfe44d4dc9e1c7c": " How long the text displays, in ticks.",
  "aeroscapes_reimagine.config.literal.2f221a1a1282811b653ea9ba001f3418af03c2f3d2ae181c1f932b56519642c7": " Example: \"[minecraft:plains, minecraft:desert]\"",
  "aeroscapes_reimagine.config.literal.366f5fbbdf61b4c9866ef874d54c04f56e70239da01aca8e46e73dad20443315": " If enabled, will render a shadow below the text making it easier to read.",
  "aeroscapes_reimagine.config.literal.39f5e3c4acd3935ba300167c24ff450a278d7ea5198e84738f6bee59933959e3": " Useful for preventing the player from being spammed if they are traveling quickly.",
  "aeroscapes_reimagine.config.literal.3bf059d9ff43120b55c89cf42df27e227fb7e632c00fb68ba672f54f3cabe75d": " Whether or not the Waystone text should be centered on the screen.",
  "aeroscapes_reimagine.config.literal.4201448fe0f082f79f022f9ce9472324df830bfb7c7a3c2c6519b2715c78962a": " the player changes dimensions.",
  "aeroscapes_reimagine.config.literal.4bcac25528005fc966514637cd89d218eccbfee6c1c7e80053ce8affc249badc": "# Waystone title settings. Only used if the Waystones mod is installed.",
  "aeroscapes_reimagine.config.literal.4f62937a3f1fa914bc4a1a0d0c0da6f735f2744bcbf094e2175e18647bc1a391": " The Text X Offset and Text Y Offset options are relative to the center of the screen if this is enabled.",
  "aeroscapes_reimagine.config.literal.50d6d6e9679b6dde1d6bd1d59ed6a04dc47642167873fc86b7b19b55cea56816": " This option determines whether or not that list should be cleared every time",
  "aeroscapes_reimagine.config.literal.51ba2b70847b15796518661a0b230f26b5925d5285e3106483bc9d826f64ae98": " The text's scale.",
  "aeroscapes_reimagine.config.literal.5b751f591b600466e0f0bdba334411ce4e536c943ea3435b9e396ef5f7f20624": " Traveler's Titles tracks a list of biomes the player most recently visited in order to",
  "aeroscapes_reimagine.config.literal.6860ecb6adc94f64326c8f085785d5496456a3d1a0374036b6b4414ac11569c0": " The minimum amount of time in ticks that must pass after a biome title is displayed before",
  "aeroscapes_reimagine.config.literal.6c5070e44d441c47ea3319499dcddfcb7f91899c90961d01774755547dd89b8d": " If Horizontally Center Title is enabled, this number is relative to the center of the screen.",
  "aeroscapes_reimagine.config.literal.6c5c88cf15cf0861853daf9c1d5d88396d1961373820ba5dd4da91065bc48b15": " Whether or not the dimension text should be centered on the screen.",
  "aeroscapes_reimagine.config.literal.70520d8e4c23c3d95c844d514daacb70d0692d7585eaf44c6e216c7f19982c45": " For example, if this value is 5, then your 5 most recent Waystones will be saved.",
  "aeroscapes_reimagine.config.literal.71ed796625faa4eeeb1c9791e2bcbf3f02681c42e25e8b9993e5658afa1cb532": " Example: \"[minecraft:overworld, minecraft:the_nether]\"",
  "aeroscapes_reimagine.config.literal.72b82889d331e7c3232c0ac25673c971974073f89cb93bbf25f96c45a3712d03": " The Waystones mod must be installed for this to have any effect.",
  "aeroscapes_reimagine.config.literal.7dbeac9e3e6bf9f41b3931aed5aad7b78a7bce723f0159822bbc491b53da6cc5": " For example, if this value is 5, then your 5 most recent biomes will be saved.",
  "aeroscapes_reimagine.config.literal.82b52dd13b8026154b3e23b7d1b1c697efc6aa7dcb61f71a91aec6294c376c63": " The pitch of the sound that plays when a Waystone title displays.",
  "aeroscapes_reimagine.config.literal.8fcb90ac546300a44f6737b0028e4ffe401e8c83080028b87207a18cc04cffda": " If Horizontally Center Title is disabled, this number is relative to the left side of the screen.",
  "aeroscapes_reimagine.config.literal.91de0df615ec3d770f19fba6f5f25b1828df50ff46c08179d3a8f5e690955511": " prevent the player from being spammed with titles when they move between the same few biomes.",
  "aeroscapes_reimagine.config.literal.927152aa37b2cfef4398e73ee5dc7771d77c36931ec4c4f092dcaade7f5e8b10": " This is the size of that list.",
  "aeroscapes_reimagine.config.literal.938e49319cc62e05388d50d76ed6ce233b4f1c3e5b780474b1e54ebd439d6048": " The distance from a Waystone (in blocks) at which the Waystone's title will trigger.",
  "aeroscapes_reimagine.config.literal.944f0bd94a9c2d901e8da900cef468b187dd83fff222624a34cdda77cb29ac52": " This prevents dimension titles from showing while the player is underground.",
  "aeroscapes_reimagine.config.literal.af159f8f65934cae76329f588c14e417b21daac85e76c4cbe9d2e06f84c4379d": " The pitch of the sound that plays when a biome title displays.",
  "aeroscapes_reimagine.config.literal.b074195bcc2463b530cb32b56745c782389b3cb31de2135a4b3aabde8effee3d": " another can be displayed.",
  "aeroscapes_reimagine.config.literal.ba5db5a6463852aba5e0d74d712ea0fe8f519876993f81b9eb5ab8f9ab15504e": "# Sound settings. These will only be used if you add custom sounds via a resource pack.",
  "aeroscapes_reimagine.config.literal.bc64e38393772bf70bbeb06f9fb9b972b3f8b3bde5ea7d35589a6a5c161a505a": " This prevents Waystone titles from showing while the player is underground.",
  "aeroscapes_reimagine.config.literal.bf560fa10c0ae89a997c87c37f5917294fc34f7daaccbc8829c32845283a0571": " The text's vertical position on the screen.",
  "aeroscapes_reimagine.config.literal.c0202b4401cb52c960f6531ba97a86d6d6906e99478153f42f8b5136c4c2c4a4": " The pitch of the sound that plays when a dimension title displays.",
  "aeroscapes_reimagine.config.literal.c61655d3c66f6e283cdd44b38b20f14338d9c185cdda9cddec874701e6473dff": " The minimum amount of time in ticks that must pass after a Waystone title is displayed before",
  "aeroscapes_reimagine.config.literal.c869801943639d0dfba6532d38ad317c09a1620127aaf9291a3ded603f6fddd4": "# Dimension Title settings.",
  "aeroscapes_reimagine.config.literal.c980f8ba7a25195e74db47a221a2fab8a3b1cf42d69b0a7a946449fcf8f13ca7": " If enabled, dimensions without ceilings (like the Overworld) will only display biome titles when the player is exposed to the skylight.",
  "aeroscapes_reimagine.config.literal.d501116cc59e3101fac46a54c8756f18bf8e3889108643bcb4a2ef51384151a4": " prevent the player from being spammed with titles when they move between the same few Waystones.",
  "aeroscapes_reimagine.config.literal.d7b985e73745cff4d8062c44bf1f1295f30d6632cd14f543dcabffda3669e6d9": " The text's default RGB color.",
  "aeroscapes_reimagine.config.literal.dd7e42819277d77f6698e9f7db2d3ee23a5c52563015107175dfd02c08e4303f": " The volume of the sound that plays when a Waystone title displays.",
  "aeroscapes_reimagine.config.literal.deb0bb5a82be8b3b9d78dfc5766237b36df1bb6483a068e43156373244c0bd59": " Dimensions that should not have any title displayed when the player enters them.",
  "aeroscapes_reimagine.config.literal.e4550040397fb65de8181c91d551eda002dbaf023445ca5dc4d07d72eb02003a": " If enabled, dimensions without ceilings (like the Overworld) will only display Waystone titles when the player is exposed to the skylight.",
  "aeroscapes_reimagine.config.literal.e7eb5e26a66518dbb19cbe0c26a8de3b78b76f2b5796fe646d01e5d900abb67a": " The volume of the sound that plays when a dimension title displays.",
  "aeroscapes_reimagine.config.literal.e980993dfb3c1654f263dfa77c011382df6ee05f291b6fe5f86c78dd22a623bc": " 20 ticks = 1 second.",
  "aeroscapes_reimagine.config.literal.eb0325fd92b100c83ae15bed7372bc5b0eb38beb148acee1141a74cf543b318a": " This prevents biome titles from showing while the player is underground.",
  "aeroscapes_reimagine.config.literal.eb5ff2fb52d04ebb060a998092903b905ca83da07a9f495b558f01fe3c3d4a98": " How long the fade-in text effect lasts, in ticks.",
  "aeroscapes_reimagine.config.literal.f9c2053f6ea4b6b7177579d841eb8be39fb54b6dab8d9c1816fef00dd784f6ed": "# For information on how to do this, visit the CurseForge page.",
  "aeroscapes_reimagine.config.literal.fbea672e27cd1ab4522ff30b66ec45f3292f859b59b2fe44d87ac26fda28bcd1": " Traveler's Titles tracks a list of Waystones the player most recently visited in order to",
