---
import Islands from "../assets/islands.svg";
import "../styles/custom.css";

interface Props {
  missing?: boolean;
}
const { missing = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Aeroscapes Reimagine</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">Minecraft · Create · Aeronautics</p>
      <h1>Aeroscapes Reimagine</h1>
      {missing ? (
        <>
          <p lang="ru">Страница не найдена. Перейдите к документации.</p>
          <p>Page not found. Open the documentation.</p>
        </>
      ) : (
        <>
          <p lang="ru">Документация сборки</p>
          <p>Modpack documentation</p>
        </>
      )}
      <nav aria-label="Language / Язык">
        <a href={`${base}/ru/`} lang="ru">
          Русский
        </a>
        <a href={`${base}/en/`} lang="en">
          English
        </a>
      </nav>
      <Islands class="islands" aria-hidden="true" />
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font-family: var(--sl-font);
  }
  main {
    max-width: 62rem;
    margin: 10vh auto 2rem;
    padding: 1.5rem clamp(1.5rem, 5vw, 4rem);
  }
  h1 {
    max-width: 13ch;
    font-size: clamp(2.8rem, 7vw, 5.6rem);
    line-height: 1.05;
    margin-block: 1rem 2rem;
    letter-spacing: -0.04em;
  }
  p {
    color: var(--sl-color-gray-2);
    font-size: 1.15rem;
  }
  .eyebrow {
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-accent-high);
  }
  nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  a {
    color: var(--sl-color-black);
    background: var(--sl-color-accent-high);
    border-radius: 0.4rem;
    padding: 0.8rem 1.4rem;
    font-weight: 600;
    text-decoration: none;
  }
  a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }
  .islands {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 2.5rem;
  }
</style>
